      "custom_instructions": []
    },
    "architect": {
      "enabled": true,
      "phase": "inception",
      "description": "AI-DLC Inception architect. Discovers and validates application business rules, produces requirements specs, Domain-Driven Design models, C4 architecture diagrams (L1-L4), ADRs, and non-overlapping work units before Construction.",
      "model": "pro",
      "mainAgent": true,
      "subagent": true,
      "commandExecutionPolicy": "sandbox",
      "inheritMcp": true,
      "inheritCustomizations": true,
      "tools": [
        "read_file",
        "edit_file",
        "write_file",
        "search_web",
        "ask_question",
