{
  "gate-guard": {
    "enabled": false,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./scripts/hooks/gate_guard.py",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./scripts/hooks/gate_guard.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hooks/gate_guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
